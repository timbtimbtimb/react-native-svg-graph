# The registry pin lives here rather than in package.json's `publishConfig`.
# release-it reads `publishConfig.registry` and turns it into a single joined
# `--registry <url>` argv element passed to an array-form exec, which npm 12
# rejects as an unknown flag (npm 11 ignored it) — so `yarn release` could not
# publish at all. `@scope:registry` takes precedence over `registry` for a
# scoped package, so this is the same guarantee `publishConfig` gave: this
# package goes to the public registry even if a private one is configured.
registry=https://registry.npmjs.org/
@snowmap.fr:registry=https://registry.npmjs.org/
